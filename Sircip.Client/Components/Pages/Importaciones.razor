@page "/importaciones"
@attribute [Authorize(Roles = "Administrador")]
@inject PadronApiClient PadronApi

<PageTitle>Importaciones del padrón</PageTitle>

@* Todo el estilo cuelga de elementos HTML escritos acá, que son los que reciben
   el atributo de scope del CSS aislado. *@
<div class="historial">

    <div class="encabezado">
        <h1>Importaciones del padrón</h1>
        <p class="subtitulo">
            Todas las importaciones realizadas, las propias y las de los demás administradores.
        </p>
    </div>

    @if (Borrado is not null)
    {
        <div class="aviso aviso-exito">
            <strong>Padrón eliminado.</strong>
            Período @FormatearPeriodoBorrado(Borrado). La constancia sigue en el historial
            marcada como borrada.
        </div>
    }

    @if (_error is not null)
    {
        <div class="aviso aviso-error">@_error</div>
    }
    else if (_importaciones is null)
    {
        <p class="estado-vacio">Cargando el historial…</p>
    }
    else if (_importaciones.Count == 0)
    {
        <div class="tarjeta estado-vacio">
            <p>Todavía no se importó ningún padrón.</p>
            <a href="importar">Importar el primero</a>
        </div>
    }
    else
    {
        <div class="tarjeta">
            <table class="grilla">
                <thead>
                    <tr>
                        <th>Período</th>
                        <th>Estado</th>
                        <th class="numero">Registros</th>
                        <th>Fecha (UTC)</th>
                        <th>Usuario</th>
                        <th>Detalle del error</th>
                        <th class="acciones"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var importacion in _importaciones)
                    {
                        <tr>
                            <td class="periodo">@FormatearPeriodo(importacion.Periodo)</td>
                            <td>
                                <span class="estado @ClaseDelEstado(importacion.Estado)">
                                    @importacion.Estado
                                </span>
                            </td>
                            <td class="numero">
                                @(importacion.Estado == EstadoImportacion.ConError
                                    ? "—"
                                    : importacion.CantidadRegistros.ToString("N0"))
                            </td>
                            <td class="fecha">@importacion.FechaImportacionUtc.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@importacion.Usuario</td>
                            <td class="detalle-error" title="@importacion.Error">@importacion.Error</td>
                            <td class="acciones">
                                @* Solo se puede eliminar el padrón vigente: las fallidas no
                                   tienen nada que borrar y las borradas ya lo están. *@
                                @if (importacion.Estado == EstadoImportacion.Exitosa)
                                {
                                    <a class="boton-eliminar"
                                       href="@($"importaciones/eliminar/{importacion.Periodo / 100}/{importacion.Periodo % 100}")">
                                        Eliminar
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    /// <summary>Período recién borrado, con formato aaaa-mm, para avisarlo al volver acá.</summary>
    [SupplyParameterFromQuery(Name = "borrado")]
    public string? Borrado { get; set; }

    private IReadOnlyList<ImportacionResponse>? _importaciones;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _importaciones = await PadronApi.ObtenerImportacionesAsync();
        }
        catch (HttpRequestException excepcion)
        {
            _error = $"No se pudo consultar el historial de importaciones: {excepcion.Message}";
        }
    }

    /// <summary>El período se guarda como aaaamm y se muestra como mm/aaaa.</summary>
    private static string FormatearPeriodo(int periodo) => $"{periodo % 100:00}/{periodo / 100}";

    /// <summary>El aviso llega como aaaa-mm por la query y se muestra como mm/aaaa.</summary>
    private static string FormatearPeriodoBorrado(string borrado)
    {
        var partes = borrado.Split('-');
        return partes.Length == 2 ? $"{partes[1]}/{partes[0]}" : borrado;
    }

    /// <summary>
    /// Los colores del estado salen del CSS de esta página y no de clases de
    /// Bootstrap: las de la librería cambiaron de nombre entre versiones y una
    /// que no existe no falla, simplemente no pinta nada.
    /// </summary>
    private static string ClaseDelEstado(EstadoImportacion estado) => estado switch
    {
        EstadoImportacion.Exitosa => "estado-exitosa",
        EstadoImportacion.ConError => "estado-error",
        _ => "estado-borrada"
    };
}
