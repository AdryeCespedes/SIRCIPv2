@page "/importaciones"
@attribute [Authorize(Roles = "Administrador")]
@inject PadronApiClient PadronApi

<PageTitle>Importaciones del padrón</PageTitle>

<h1>Importaciones del padrón</h1>
<p class="text-muted">
    Historial de todas las importaciones realizadas, las propias y las de los demás administradores.
</p>

@if (Borrado is not null)
{
    <div class="alert alert-success">
        Se eliminó el padrón de <strong>@FormatearPeriodoBorrado(Borrado)</strong>.
        La constancia sigue en el historial marcada como borrada.
    </div>
}

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_importaciones is null)
{
    <p><em>Cargando el historial…</em></p>
}
else if (_importaciones.Count == 0)
{
    <p>Todavía no se importó ningún padrón.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Período</th>
                    <th>Estado</th>
                    <th class="text-end">Registros</th>
                    <th>Fecha (UTC)</th>
                    <th>Usuario</th>
                    <th>Detalle del error</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var importacion in _importaciones)
                {
                    <tr>
                        <td>@FormatearPeriodo(importacion.Periodo)</td>
                        <td>
                            <span class="badge @ClaseDelEstado(importacion.Estado)">@importacion.Estado</span>
                        </td>
                        <td class="text-end">
                            @(importacion.Estado == EstadoImportacion.ConError
                                ? "—"
                                : importacion.CantidadRegistros.ToString("N0"))
                        </td>
                        <td>@importacion.FechaImportacionUtc.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@importacion.Usuario</td>
                        <td class="detalle-error">@importacion.Error</td>
                        <td class="text-end">
                            @* Solo se puede eliminar el padrón vigente: las fallidas no
                               tienen nada que borrar y las borradas ya lo están. *@
                            @if (importacion.Estado == EstadoImportacion.Exitosa)
                            {
                                <a class="btn btn-outline-danger btn-sm"
                                   href="@($"importaciones/eliminar/{importacion.Periodo / 100}/{importacion.Periodo % 100}")">
                                    Eliminar
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    /// <summary>Período recién borrado, con formato aaaa-mm, para avisarlo al volver acá.</summary>
    [SupplyParameterFromQuery(Name = "borrado")]
    public string? Borrado { get; set; }

    private IReadOnlyList<ImportacionResponse>? _importaciones;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _importaciones = await PadronApi.ObtenerImportacionesAsync();
        }
        catch (HttpRequestException excepcion)
        {
            _error = $"No se pudo consultar el historial de importaciones: {excepcion.Message}";
        }
    }

    /// <summary>El período se guarda como aaaamm y se muestra como mm/aaaa.</summary>
    private static string FormatearPeriodo(int periodo) => $"{periodo % 100:00}/{periodo / 100}";

    /// <summary>El aviso llega como aaaa-mm por la query y se muestra como mm/aaaa.</summary>
    private static string FormatearPeriodoBorrado(string borrado)
    {
        var partes = borrado.Split('-');
        return partes.Length == 2 ? $"{partes[1]}/{partes[0]}" : borrado;
    }

    /// <summary>
    /// El cliente trae Bootstrap 5.1, donde las clases text-bg-* todavía no
    /// existen: hay que usar bg-*, porque .badge ya deja el texto en blanco y
    /// sin una clase de fondo el estado queda blanco sobre blanco.
    /// </summary>
    private static string ClaseDelEstado(EstadoImportacion estado) => estado switch
    {
        EstadoImportacion.Exitosa => "bg-success",
        EstadoImportacion.ConError => "bg-danger",
        _ => "bg-secondary"
    };
}
